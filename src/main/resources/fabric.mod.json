{
  "schemaVersion": 1,
  "id": "moblassopolymer",
  "version": "${version}",
  "name": "Mob Lasso (Polymer)",
  "description": "Capture and transport mobs using a lasso — runs entirely server-side via Polymer!",
  "authors": ["MobLassoPolymer"],
  "contact": {
    "homepage": "https://github.com/moblassopolymer/mob-lasso-polymer"
  },
  "license": "MIT",
  "icon": "assets/moblassopolymer/textures/item/friendly_lasso.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.github.moblassopolymer.MobLassoPolymer"]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "fabric-api": "*",
    "minecraft": ">=26.3",
    "polymer-core": ">=0.18.0",
    "polymer-resource-pack": ">=0.18.0",
    "polymer-autohost": ">=0.18.0"
  }
}
